generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectType {
  SCRUM
  KANBAN
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum IssueStatus {
  TO_DO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum IssuePriority {
  HIGHEST
  HIGH
  MEDIUM
  LOW
  LOWEST
}

enum SprintStatus {
  FUTURE
  ACTIVE
  CLOSED
}

enum NotificationType {
  MENTION
  ASSIGNMENT
  STATUS_CHANGE
  COMMENT
}

enum AutomationTrigger {
  ISSUE_CREATED
  STATUS_CHANGED
  COMMENT_ADDED
}

enum AutomationAction {
  ASSIGN_USER
  UPDATE_STATUS
  ADD_COMMENT
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                     String          @id @default(cuid())
  email                  String          @unique
  name                   String
  passwordHash           String?
  avatarUrl              String?
  createdAt              DateTime        @default(now())
  memberships            Membership[]
  projectMemberships     ProjectMember[]
  ledProjects            Project[]       @relation("ProjectLead")
  reportedIssues         Issue[]         @relation("ReportedIssues")
  assignedIssues         Issue[]         @relation("AssignedIssues")
  comments               Comment[]
  historyEntries         IssueHistory[]
  notifications          Notification[]  @relation("UserNotifications")
  triggeredNotifications Notification[]  @relation("ActorNotifications")
  watchedIssues          Watcher[]
  savedFilters           SavedFilter[]
  stars                  Star[]
  workLogs               WorkLog[]
  attachments            Attachment[]
}

model Site {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  invites     Invite[]
  projects    Project[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

model Invite {
  id         String    @id @default(cuid())
  siteId     String
  email      String
  token      String    @unique
  role       Role      @default(MEMBER)
  projectId  String?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([email, acceptedAt, expiresAt])
  @@index([siteId])
}

model Project {
  id              String           @id @default(cuid())
  siteId          String
  name            String
  key             String
  type            ProjectType      @default(KANBAN)
  leadId          String
  issueCounter    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  site            Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  lead            User             @relation("ProjectLead", fields: [leadId], references: [id])
  issues          Issue[]
  sprints         Sprint[]
  automationRules AutomationRule[]
  customFields    CustomField[]
  stars           Star[]
  members         ProjectMember[]
  invites         Invite[]
  gitRepositories GitRepository[]

  @@unique([siteId, key])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(FUTURE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([projectId, status])
}

model Issue {
  id          String        @id @default(cuid())
  projectId   String
  sprintId    String?
  number      Int
  key         String
  summary     String
  description String?
  type        IssueType     @default(STORY)
  status      IssueStatus   @default(TO_DO)
  priority    IssuePriority @default(MEDIUM)
  storyPoints Float?
  originalEstimate Float?
  rank        Float         @default(0)
  reporterId  String
  assigneeId  String?
  parentId    String?
  labels      String[]      @default([])
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  reporter    User          @relation("ReportedIssues", fields: [reporterId], references: [id])
  assignee    User?         @relation("AssignedIssues", fields: [assigneeId], references: [id])
  parent      Issue?        @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks    Issue[]       @relation("IssueHierarchy")
  comments    Comment[]
  history     IssueHistory[]
  watchers    Watcher[]
  workLogs    WorkLog[]
  attachments Attachment[]
  linksOut    IssueLink[]   @relation("LinkSource")
  linksIn     IssueLink[]   @relation("LinkTarget")
  gitCommits  GitCommit[]
  pullRequests PullRequest[]
  gitBranches GitBranch[]

  @@unique([projectId, number])
  @@unique([projectId, key])
  @@index([projectId, status, rank])
  @@index([projectId, sprintId, rank])
  @@index([projectId, assigneeId])
  @@index([projectId, reporterId])
  @@index([parentId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([issueId, createdAt])
}

model IssueHistory {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([issueId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  uploaderId String
  filename   String
  url        String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id])

  @@index([issueId])
}

enum LinkRelation {
  RELATES_TO
  BLOCKS
  IS_BLOCKED_BY
  DUPLICATES
}

model IssueLink {
  id           String       @id @default(cuid())
  sourceIssueId String
  targetIssueId String
  relation     LinkRelation
  createdAt    DateTime     @default(now())
  sourceIssue  Issue        @relation("LinkSource", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssue  Issue        @relation("LinkTarget", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([sourceIssueId, targetIssueId, relation])
  @@index([sourceIssueId])
  @@index([targetIssueId])
}

model WorkLog {
  id          String   @id @default(cuid())
  issueId     String
  authorId    String
  hours       Float
  description String?
  startedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])

  @@index([issueId])
  @@index([issueId, startedAt])
  @@index([authorId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String
  type      NotificationType
  title     String
  message   String
  link      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User             @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model Watcher {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  jql       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AutomationRule {
  id           String            @id @default(cuid())
  projectId    String
  name         String
  eventTrigger AutomationTrigger
  action       AutomationAction
  targetValue  String
  enabled      Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CustomField {
  id        String   @id @default(cuid())
  projectId String
  name      String
  fieldType String   @default("STRING")
  required  Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Star {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model GitRepository {
  id            String        @id @default(cuid())
  projectId     String
  owner         String
  repoName      String
  accessToken   String?
  webhookSecret String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commits       GitCommit[]
  pullRequests  PullRequest[]
  branches      GitBranch[]

  @@unique([projectId, owner, repoName])
  @@index([projectId])
}

model GitCommit {
  id           String        @id @default(cuid())
  repositoryId String
  hash         String
  message      String
  authorName   String
  authorAvatar String?
  committedAt  DateTime
  issueId      String?
  url          String?
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue        Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([issueId])
}

model PullRequest {
  id           String        @id @default(cuid())
  repositoryId String
  prNumber     Int
  title        String
  status       String        // OPEN, MERGED, CLOSED
  authorName   String
  authorAvatar String?
  issueId      String?
  url          String?
  createdAt    DateTime      @default(now())
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue        Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([issueId])
}

model GitBranch {
  id             String        @id @default(cuid())
  repositoryId   String
  name           String
  lastCommitHash String?
  issueId        String?
  repository     GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue          Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([issueId])
}
