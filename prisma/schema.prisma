generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ProjectType {
  SCRUM
  KANBAN
}

enum IssueType {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum IssueStatus {
  TO_DO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum IssuePriority {
  HIGHEST
  HIGH
  MEDIUM
  LOW
  LOWEST
}

enum SprintStatus {
  FUTURE
  ACTIVE
  CLOSED
}

enum RetroColumn {
  WENT_WELL
  NEEDS_IMPROVEMENT
  ACTION_ITEMS
}

enum NotificationType {
  MENTION
  ASSIGNMENT
  STATUS_CHANGE
  COMMENT
}

enum AutomationTrigger {
  ISSUE_CREATED
  STATUS_CHANGED
  COMMENT_ADDED
}

enum AutomationAction {
  ASSIGN_USER
  UPDATE_STATUS
  ADD_COMMENT
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id                     String          @id @default(cuid())
  email                  String          @unique
  name                   String
  passwordHash           String?
  avatarUrl              String?
  createdAt              DateTime        @default(now())
  memberships            Membership[]
  projectMemberships     ProjectMember[]
  ledProjects            Project[]       @relation("ProjectLead")
  reportedIssues         Issue[]         @relation("ReportedIssues")
  assignedIssues         Issue[]         @relation("AssignedIssues")
  comments               Comment[]
  historyEntries         IssueHistory[]
  notifications          Notification[]  @relation("UserNotifications")
  triggeredNotifications Notification[]  @relation("ActorNotifications")
  watchedIssues          Watcher[]
  savedFilters           SavedFilter[]
  stars                  Star[]
  workLogs               WorkLog[]
  attachments            Attachment[]
  ledComponents          ProjectComponent[] @relation("ComponentLead")
  retroCards             RetroCard[]        @relation("RetroCardAuthor")
  retroCardAssignments   RetroCard[]        @relation("RetroCardAssignee")
  retroVotes             RetroVote[]
}

model Site {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  allowedDomain    String?
  restrictedDomain Boolean           @default(false)
  createdAt        DateTime          @default(now())
  memberships      Membership[]
  invites          Invite[]
  projects         Project[]
  gitInstallations GitInstallation[]
  gitRepositories  GitRepository[]
  gitCommits       GitCommit[]
  pullRequests     PullRequest[]
  gitBranches      GitBranch[]
  gitWebhookLogs   GitWebhookLog[]
  integrations     SiteIntegration[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
}

model Invite {
  id         String    @id @default(cuid())
  siteId     String
  email      String?
  token      String    @unique
  role       Role      @default(MEMBER)
  projectId  String?
  // A share link (isReusable) has no single recipient — anyone holding the
  // token may accept it, repeatedly, until expiry or revocation. A targeted
  // email invite stays single-use: acceptedAt blocks reuse and the accepting
  // signup email must match.
  isReusable Boolean   @default(false)
  revokedAt  DateTime?
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([email, acceptedAt, expiresAt])
  @@index([siteId])
  @@index([projectId, isReusable, revokedAt])
}

model Project {
  id              String           @id @default(cuid())
  siteId          String
  name            String
  key             String
  type            ProjectType      @default(KANBAN)
  leadId          String
  issueCounter    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  site            Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  lead            User             @relation("ProjectLead", fields: [leadId], references: [id])
  issues          Issue[]
  sprints         Sprint[]
  releases        Release[]
  automationRules AutomationRule[]
  customFields    CustomField[]
  stars           Star[]
  members         ProjectMember[]
  invites         Invite[]
  gitRepositories GitRepository[]
  components      ProjectComponent[]
  slaPolicies     SlaPolicy[]
  ideas           Idea[]
  retroCards      RetroCard[]

  @@unique([siteId, key])
  @@index([leadId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Sprint {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  goal        String?
  startDate   DateTime?
  endDate     DateTime?
  status      SprintStatus @default(FUTURE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      Issue[]
  retroCards  RetroCard[]

  @@index([projectId, status])
}

enum ReleaseStatus {
  UNRELEASED
  RELEASED
  ARCHIVED
}

model Release {
  id            String        @id @default(cuid())
  projectId     String
  name          String
  description   String?
  status        ReleaseStatus @default(UNRELEASED)
  releaseDate   DateTime?
  notesMarkdown String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues        Issue[]

  @@index([projectId])
}

model Issue {
  id               String         @id @default(cuid())
  projectId        String
  sprintId         String?
  releaseId        String?
  number           Int
  key              String
  summary          String
  description      String?
  type             IssueType      @default(STORY)
  status           IssueStatus    @default(TO_DO)
  priority         IssuePriority  @default(MEDIUM)
  storyPoints      Float?
  originalEstimate Float?
  rank             Float          @default(0)
  reporterId       String
  assigneeId       String?
  parentId         String?
  labels           String[]       @default([])
  startDate        DateTime?
  dueDate          DateTime?
  viewsCount       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint           Sprint?        @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  release          Release?       @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  reporter         User           @relation("ReportedIssues", fields: [reporterId], references: [id])
  assignee         User?          @relation("AssignedIssues", fields: [assigneeId], references: [id])
  parent           Issue?         @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks         Issue[]        @relation("IssueHierarchy")
  comments         Comment[]
  history          IssueHistory[]
  watchers         Watcher[]
  workLogs         WorkLog[]
  attachments      Attachment[]
  linksOut         IssueLink[]    @relation("LinkSource")
  linksIn          IssueLink[]    @relation("LinkTarget")
  gitCommits       GitCommit[]
  pullRequests     PullRequest[]
  gitBranches      GitBranch[]

  @@unique([projectId, number])
  @@unique([projectId, key])
  @@index([projectId, status, rank])
  @@index([projectId, sprintId, rank])
  @@index([projectId, releaseId])
  @@index([projectId, assigneeId])
  @@index([projectId, reporterId])
  @@index([parentId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([issueId, createdAt])
  @@index([authorId])
}

model IssueHistory {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([issueId, createdAt])
  @@index([authorId])
}

model Attachment {
  id         String   @id @default(cuid())
  issueId    String
  uploaderId String
  filename   String
  url        String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())
  issue      Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id])

  @@index([issueId])
  @@index([uploaderId])
}

enum LinkRelation {
  RELATES_TO
  BLOCKS
  IS_BLOCKED_BY
  DUPLICATES
}

model IssueLink {
  id            String       @id @default(cuid())
  sourceIssueId String
  targetIssueId String
  relation      LinkRelation
  createdAt     DateTime     @default(now())
  sourceIssue   Issue        @relation("LinkSource", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssue   Issue        @relation("LinkTarget", fields: [targetIssueId], references: [id], onDelete: Cascade)

  @@unique([sourceIssueId, targetIssueId, relation])
  @@index([sourceIssueId])
  @@index([targetIssueId])
}

model WorkLog {
  id          String   @id @default(cuid())
  issueId     String
  authorId    String
  hours       Float
  description String?
  startedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])

  @@index([issueId, startedAt])
  @@index([authorId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String
  type      NotificationType
  title     String
  message   String
  link      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User             @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([actorId])
}

model Watcher {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@index([userId])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  jql       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AutomationRule {
  id           String            @id @default(cuid())
  projectId    String
  name         String
  eventTrigger AutomationTrigger
  action       AutomationAction
  targetValue  String
  enabled      Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CustomField {
  id        String   @id @default(cuid())
  projectId String
  name      String
  fieldType String   @default("STRING")
  required  Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Star {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

model DeletedBoardLog {
  id              String   @id @default(cuid())
  siteId          String
  projectKey      String
  projectName     String
  deletedByUserId String
  deletedByName   String
  deletedByEmail  String
  createdAt       DateTime @default(now())

  @@index([siteId, projectKey])
}

model GitInstallation {
  id             String          @id @default(cuid())
  siteId         String
  installationId String          @unique
  accountName    String
  accountType    String          @default("USER") // USER or ORGANIZATION
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  repositories   GitRepository[]

  @@index([siteId])
}

model GitRepository {
  id             String           @id @default(cuid())
  siteId         String
  projectId      String
  installationId String?
  owner          String
  repoName       String
  accessToken    String?
  webhookSecret  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  site           Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  installation   GitInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  commits        GitCommit[]
  pullRequests   PullRequest[]
  branches       GitBranch[]

  @@unique([projectId, owner, repoName])
  @@index([siteId])
  @@index([installationId])
}

model GitCommit {
  id           String        @id @default(cuid())
  siteId       String
  repositoryId String
  hash         String
  message      String
  authorName   String
  authorAvatar String?
  committedAt  DateTime
  issueId      String?
  url          String?
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue        Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, hash])
  @@index([siteId])
  @@index([issueId])
}

model PullRequest {
  id           String        @id @default(cuid())
  siteId       String
  repositoryId String
  prNumber     Int
  title        String
  status       String // OPEN, MERGED, CLOSED
  authorName   String
  authorAvatar String?
  issueId      String?
  url          String?
  createdAt    DateTime      @default(now())
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  repository   GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue        Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, prNumber])
  @@index([siteId])
  @@index([issueId])
}

model GitBranch {
  id             String        @id @default(cuid())
  siteId         String
  repositoryId   String
  name           String
  lastCommitHash String?
  issueId        String?
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  repository     GitRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue          Issue?        @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, name])
  @@index([siteId])
  @@index([issueId])
}

model GitWebhookLog {
  id             String   @id @default(cuid())
  siteId         String
  event          String // push, pull_request, create, delete
  action         String?
  repositoryName String?
  senderName     String?
  status         String   @default("PROCESSED") // PROCESSED, FAILED
  createdAt      DateTime @default(now())
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model SiteIntegration {
  id            String    @id @default(cuid())
  siteId        String
  provider      String // GITHUB | GITLAB | SLACK | SENTRY | DATADOG | VERCEL | ZENDESK | DISCORD | INTERCOM | FIGMA | LOOM | MIRO | ZAPIER | BITBUCKET
  status        String    @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR
  accessToken   String? // Encrypted OAuth token or API key
  refreshToken  String?
  accountName   String? // GitHub org / Slack workspace / Sentry org slug
  accountAvatar String?
  webhookSecret String? // HMAC signing secret for inbound webhook verification
  webhookUrl    String? // Outbound webhook URL (Slack, Discord)
  metadata      String? // JSON: channelId, teamId, externalProjectId, etc.
  connectedAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, provider])
  @@index([siteId])
}

model ProjectComponent {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  leadId      String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lead        User?    @relation("ComponentLead", fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_components_v2")
}

model SlaPolicy {
  id                 String   @id @default(cuid())
  projectId          String
  name               String
  targetResponseMins Int      @default(15)
  targetResolveMins  Int      @default(240)
  businessHours      String   @default("24x7")
  createdAt          DateTime @default(now())
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Idea {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  impactScore Float    @default(5.0)
  effortScore Float    @default(5.0)
  upvotes     Int      @default(0)
  status      String   @default("UNDER_CONSIDERATION")
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}


model RetroCard {
  id               String      @id @default(cuid())
  sprintId         String
  projectId        String
  column           RetroColumn
  text             String
  authorId         String
  isAnonymous      Boolean     @default(false)
  convertedIssueId String?
  assigneeId       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  sprint    Sprint      @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User        @relation("RetroCardAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignee  User?       @relation("RetroCardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  votes     RetroVote[]

  @@index([sprintId])
  @@index([projectId])
  @@index([authorId])
}

model RetroVote {
  id        String    @id @default(cuid())
  cardId    String
  userId    String
  createdAt DateTime  @default(now())

  card      RetroCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([cardId])
}
